NEXT_PUBLIC_SANITY_PROJECT_ID=qhuqrj1j
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity tokens (manage.sanity.io → API → Tokens). Server-only.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# Shared secret of the GROQ webhook that POSTs {_type} to /api/revalidate-tag
SANITY_REVALIDATE_SECRET=

# Resend – without a key, e-mails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Build 2 Play <posvet@buildtoplay.si>"

# Pre-launch gate: while set, visitors only see the coming-soon page. Share /predogled?k=<key> to let someone in
# (e.g. `openssl rand -base64 24 | tr '+/' '-_'`). Remove it and redeploy to launch.
# SITE_GATE_KEY=
