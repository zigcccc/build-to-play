{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "SANITY_*", "RESEND_API_KEY", "EMAIL_FROM", "SITE_GATE_KEY", "VERCEL_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NEXT_PUBLIC_*", "SANITY_*", "RESEND_API_KEY", "EMAIL_FROM", "SITE_GATE_KEY"]
    }
  }
}
